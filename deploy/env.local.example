# Production settings for the cPanel account. Copy to backend/.env.local, fill in, then: chmod 600 backend/.env.local
# It is never committed (backend/.gitignore ignores .env.local), so a git pull cannot overwrite it.
APP_ENV=prod
# 32+ random characters, e.g. from: php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=change-me

# cPanel > MySQL Databases: create the database and user, give the user ALL PRIVILEGES.
# serverVersion MUST match the real server: run "mysql -V" (or SELECT VERSION() in phpMyAdmin) and copy it.
# cPanel usually runs MariaDB, which needs the suffix, e.g. serverVersion=10.6.19-MariaDB; MySQL is e.g. 8.0.39.
# deploy/cpanel-update.sh refuses to continue until it matches, and says what to put.
DATABASE_URL="mysql://cpaneluser_app:PASSWORD@localhost:3306/cpaneluser_obras?serverVersion=10.6.19-MariaDB&charset=utf8mb4"

# cPanel > Email Accounts: create e.g. no-reply@yourdomain.com. Special characters in the password must be URL-encoded.
MAILER_DSN="smtp://no-reply%40yourdomain.com:PASSWORD@mail.yourdomain.com:465"
MAILER_FROM="Control de Proyectos <no-reply@yourdomain.com>"

# Public address of the app (used in email links).
APP_URL=https://obras.yourdomain.com
DEFAULT_URI=https://obras.yourdomain.com

# Let admins use "Ver como" (view the app as another user) in production. 1 = on.
IMPERSONATION_ENABLED=0
