{% extends 'emails/layout.html.twig' %}
{% set link = '/projects/' ~ project.id ~ '?tab=expenses' %}
{% block content %}
<p>{{ 'expense_rejected.body'|trans({expense: expense.description, amount: amount, project: project.name}, 'emails') }}</p>
<blockquote style="margin:0;padding:8px 12px;border-left:4px solid #b3261e;background:#fdecea;">{{ expense.rejectionReason }}</blockquote>
<p>{{ 'expense_rejected.next'|trans({}, 'emails') }}</p>
{% endblock %}
