{% extends 'emails/layout.html.twig' %}
{% set link = '/projects/' ~ project.id ~ '?tab=expenses' %}
{% block content %}
<p><strong>{{ expense.paidBy }}</strong> registró un gasto por <strong>{{ amount }}</strong> en <strong>{{ project.name }}</strong> que espera tu aprobación:</p>
<p>{{ expense.description }} · {{ expense.stage }} · {{ expense.category }}</p>
{% endblock %}
