{% extends 'emails/layout.html.twig' %}
{% set link = '/projects/' ~ project.id ~ '?tab=petty-cash' %}
{% block content %}
<p>{{ 'cycle_closed.body'|trans({by: closedBy, number: cycle.number, project: project.name, balance: balance}, 'emails') }}</p>
{% if cycle.note %}<p>{{ 'cycle_closed.note'|trans({note: cycle.note}, 'emails') }}</p>{% endif %}
<p>{{ 'cycle_closed.next'|trans({}, 'emails') }}</p>
{% endblock %}
