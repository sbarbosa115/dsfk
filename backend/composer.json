{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4.1",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "brick/money": "^0.15.1",
    "doctrine/doctrine-bundle": "^3.3.2",
    "doctrine/doctrine-migrations-bundle": "^3.7 || ^4.0.1",
    "doctrine/orm": "^3.7",
    "nelmio/api-doc-bundle": "*",
    "phpdocumentor/reflection-docblock": "^6.0",
    "phpstan/phpdoc-parser": "^2.3",
    "symfony/apache-pack": "*",
    "symfony/console": "8.1.*",
    "symfony/doctrine-messenger": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/flex": "^2",
    "symfony/framework-bundle": "8.1.*",
    "symfony/intl": "8.1.*",
    "symfony/mailer": "8.1.*",
    "symfony/messenger": "8.1.*",
    "symfony/monolog-bundle": "^4.1",
    "symfony/property-access": "8.1.*",
    "symfony/property-info": "8.1.*",
    "symfony/rate-limiter": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/serializer": "8.1.*",
    "symfony/stimulus-bundle": "^3.5",
    "symfony/translation": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/uid": "8.1.*",
    "symfony/ux-react": "^3.5",
    "symfony/validator": "8.1.*",
    "symfony/webpack-encore-bundle": "^2.4",
    "symfony/yaml": "8.1.*",
    "twig/extra-bundle": "^3.29"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "phpstan/extension-installer": true
    },
    "bump-after-update": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "deptrac": [
      "deptrac analyse --config-file=deptrac.layers.yaml --no-progress",
      "deptrac analyse --config-file=deptrac.contexts.yaml --no-progress"
    ],
    "analyse": [
      "@cs",
      "phpstan analyse --memory-limit=1G",
      "@deptrac"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  },
  "require-dev": {
    "dama/doctrine-test-bundle": "^8.6",
    "deptrac/deptrac": "*",
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "friendsofphp/php-cs-fixer": "*",
    "phpstan/extension-installer": "*",
    "phpstan/phpstan": "*",
    "phpstan/phpstan-doctrine": "*",
    "phpstan/phpstan-phpunit": "*",
    "phpstan/phpstan-symfony": "*",
    "phpunit/phpunit": "^12.5",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/maker-bundle": "^1.68"
  }
}
